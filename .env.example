# ── Docker Compose Environment Variables ──
# Copy to .env in the project root and fill in all values.

# Database
POSTGRES_USER=omniqueue
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=omniqueue
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=5100
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_EXPIRES_IN=12h
CUSTOMER_JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
STAFF_PIN=CHANGE_ME_STRONG_PIN
CORS_ORIGIN=
LOG_LEVEL=info

# Booking verification. `console` only writes the code to the server log —
# replace it with a real SMS gateway before going live.
OTP_ENABLED=true
OTP_PROVIDER=console

# AI Engine
AI_ENGINE_PORT=5001
AI_ENGINE_TIMEOUT_MS=2000

# NOTE: this file is for the Docker stack only. A local run needs no .env at all;
# see SETUP.md.
