# ── Omni-Queue 360 Backend Environment Variables ──
# Every value below has a working development default, so the backend starts on a
# bare checkout with no .env file and no Redis, Postgres or Docker installed.
# Copy this file to .env only when you want to change something.

# Server
PORT=5100
NODE_ENV=development
LOG_LEVEL=debug

# ── Queue store ───────────────────────────────────────────────────────────
# auto   → use Redis if one is reachable, otherwise an in-process store (default
#          in development; state lives in this process and is lost on restart)
# redis  → refuse to start without Redis (the production default)
# memory → never touch Redis, even if one is running
QUEUE_STORE=auto
REDIS_URL=redis://127.0.0.1:6379

# ── Database (optional) ───────────────────────────────────────────────────
# Leave DATABASE_URL empty, or set USE_DATABASE=false, to run without Postgres.
# With Postgres the schema is created and migrated automatically on boot.
DATABASE_URL=
USE_DATABASE=false

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
# Staff/admin sessions end with the shift...
JWT_EXPIRES_IN=12h
# ...but a customer's ticket has to outlive it.
CUSTOMER_JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
STAFF_PIN=1234

# CORS (comma-separated origins, leave empty to allow all in development)
CORS_ORIGIN=

# ── Online booking verification ───────────────────────────────────────────
# console → the code is written to the server log and echoed to the caller in
#           development, so the flow is demonstrable with no SMS provider.
OTP_ENABLED=true
OTP_PROVIDER=console
# Never has any effect when NODE_ENV=production.
OTP_DEV_ECHO=true

# ── AI engine ─────────────────────────────────────────────────────────────
# Leave empty to disable the engine entirely; the backend then uses its built-in
# queueing estimate and ticketing is unaffected.
AI_ENGINE_URL=http://127.0.0.1:5001
AI_ENGINE_TIMEOUT_MS=2000
# How often served tickets are shipped to the engine for retraining, and the
# minimum history required before it will fit a model at all.
AI_TRAINING_INTERVAL_MS=900000
AI_TRAINING_MIN_SAMPLES=30

# Fallback service-time bounds used when there is no history yet (minutes)
DEFAULT_AVERAGE_SERVICE_TIME_MINS=5
MIN_AVERAGE_SERVICE_TIME_MINS=1
MAX_AVERAGE_SERVICE_TIME_MINS=60

# ── Note on operating rules ───────────────────────────────────────────────
# Opening hours, slot length, booking horizon, check-in window, no-show
# timeouts and per-customer ticket caps are NOT environment variables. They are
# seeded from src/config/constants.js on first boot and owned by the admin
# Operations screen thereafter, so changing policy never means a redeploy.
